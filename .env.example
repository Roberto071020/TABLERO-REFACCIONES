# Copia este archivo a .env y ajusta los valores antes de desplegar a producción.
PORT=3000
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria-unica

# Fase 1, punto 10 PORTAL SC (Orlando, 8-sep-2026): integración con Google Drive (Picker, alcance
# drive.file -- sin auditoría CASA, ver Integracion_Google_Drive_Punto10.docx). Se generan al crear un
# proyecto en Google Cloud y configurar la pantalla de consentimiento OAuth como app "Externa" con
# únicamente el alcance drive.file. Mientras no estén las tres, la integración queda desactivada de forma
# segura (respuestas 501 explícitas, nunca datos simulados).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_API_KEY=
# Opcional -- número de proyecto de Google Cloud, lo pide el Picker para poder mostrarse.
GOOGLE_DRIVE_APP_ID=
# Opcional -- solo si el proyecto de Google Cloud exige un URI de redirección fijo distinto del host real
# de la petición (por defecto se calcula solo: https://<host>/api/google-drive/oauth/callback).
GOOGLE_DRIVE_REDIRECT_URI=

